# === Copiar este archivo como .env y rellenar los valores ===

# === opencode-go (LLM para seleccion de clips) ===
OPENCODE_API_KEY=tu_api_key_de_opencode_go
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash

# === Hugging Face (gratis) - token opcional para mas quota en los Spaces ===
# Crear en: https://huggingface.co/settings/tokens  (tipo "Read")
HF_TOKEN=tu_hf_token_aqui

# Verificacion SSL de los Spaces.
#   - Red con proxy corporativo/educativo (MITM): false
#   - Red normal de casa: true  (recomendado, valida certificados)
HF_SSL_VERIFY=false

# === Avatar (gratis, sin API key) ===
AVATAR_PROMPT=beautiful young latina woman, long dark wavy hair, glamorous natural makeup, stylish fitted top, sitting at a modern streaming desk setup with RGB lights and dual monitors, looking at the screen with an excited engaged smile, cozy bedroom, cinematic colorful lighting, bokeh background, photorealistic, ultra detailed, 4k
AVATAR_IMAGE=assets/avatar/avatar.jpg

# === Avatar animado (image-to-video, gratis) ===
AVATAR_I2V_SPACE=Lightricks/ltx-video-distilled
AVATAR_I2V_FALLBACK=multimodalart/stable-video-diffusion
AVATAR_MOTION_PROMPT=young woman sits at streaming desk watching the screen, natural blink, subtle head movement, slight confident smile, hair moves gently, breathing, cinematic lighting, photorealistic, smooth natural motion
AVATAR_NEGATIVE_PROMPT=worst quality, blurry, distorted face, deformed hands, extra limbs, jittery, flicker, morphing, low resolution
AVATAR_I2V_DURATION=3
AVATAR_I2V_WIDTH=640
AVATAR_I2V_HEIGHT=576

# === Nicho y busqueda automatica (YouTube Creative Commons) ===
NICHE=curiosidades
DISCOVER_PER_QUERY=5
DISCOVER_MIN_DURATION=120
DISCOVER_MAX_DURATION=5400

# === Voz del avatar (Kokoro espanol, gratis) ===
TTS_ENABLED=true
TTS_SPACE=leonelhs/kokoro-tts-spanish
TTS_VOICE=ef_dora
TTS_SPEED=0.95
CLIP_AUDIO_VOLUME=0.35
VOICEOVER_VOLUME=1.0

# === Mejora de rostro del avatar (CodeFormer, gratis) ===
ENHANCE_ENABLED=true
ENHANCE_SPACE=sczhou/CodeFormer
ENHANCE_FIDELITY=0.7

# === Subtitulos (estilo viral, karaoke) ===
SUBTITLE_ENABLED=true
SUBTITLE_FONT=Arial
SUBTITLE_FONTSIZE=62
SUBTITLE_OUTLINE=5
SUBTITLE_MARGIN_V=60
SUBTITLE_MAX_WORDS=3
SUBTITLE_MAX_GAP=0.6
SUBTITLE_MAX_DURATION=1.8

# === Whisper ===
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# === Salida ===
REEL_WIDTH=1080
REEL_HEIGHT=1920
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=60
MAX_CLIPS=3
